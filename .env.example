# =============================================================================
# AI-KBS development environment — .env.example
#
# Copy to .env (cp .env.example .env) and edit secrets. Never commit .env.
# All variables are read by docker-compose.dev.yml; see that file for the
# service that consumes each block.
#
# Sections:
#   A. Timezone / runtime
#   B. PostgreSQL (primary store)
#   C. Redis (session / cache / pubsub)
#   D. RabbitMQ (async work queue)
#   E. Elasticsearch (BM25 + Dense + Hybrid)
#   F. Backend (Go server)
#   G. docreader (Python gRPC)
#   H. SAG bridge
#   I. MCP server
#   J. Langfuse (observability)
# =============================================================================


# #############################################################################
# A. Timezone / runtime
# #############################################################################

TZ=UTC


# #############################################################################
# B. PostgreSQL — primary store (T1.x migrations create the actual schema).
# #############################################################################

POSTGRES_USER=aikbs
POSTGRES_PASSWORD=changeme-postgres-dev
POSTGRES_DB=aikbs
POSTGRES_PORT=5432

# Langfuse metadata store (separate logical DB on the same Postgres instance).
LANGFUSE_DB=langfuse


# #############################################################################
# C. Redis — session / cache / pubsub
# #############################################################################

REDIS_PORT=6379


# #############################################################################
# D. RabbitMQ — async parse / index work queue (FR-PARSE-03)
# #############################################################################

RABBITMQ_USER=aikbs
RABBITMQ_PASSWORD=changeme-rabbitmq-dev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672


# #############################################################################
# E. Elasticsearch — BM25 + Dense + Hybrid retrieval.
# #############################################################################

ES_PORT=9200
# JVM heap. 512m is fine for < 100k documents; bump for heavier dev loads.
ES_HEAP=512m


# #############################################################################
# F. Backend — Go server (WeKnora fork, T0.1).
# #############################################################################

BACKEND_PORT=8080
GIN_MODE=debug


# #############################################################################
# G. docreader — Python gRPC service (T1.x).
# #############################################################################

DOCREADER_PORT=50051


# #############################################################################
# H. SAG bridge — multi-hop retrieval (event / entity / dynamic hyperedge).
# #############################################################################

SAG_BRIDGE_PORT=8090


# #############################################################################
# I. MCP server — FastMCP transports (T2.10).
# #############################################################################

MCP_PORT=8081
# stdio | sse | http
AIKBS_MCP_TRANSPORT=stdio


# #############################################################################
# J. Langfuse — observability (OTLP traces + dashboards)
# #############################################################################

LANGFUSE_WEB_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# Change these for any non-dev deployment. The defaults below are dev-only
# and intentionally weak so they fail loud in production.
LANGFUSE_NEXTAUTH_SECRET=ai-kbs-langfuse-dev-secret-change-me
LANGFUSE_SALT=ai-kbs-langfuse-dev-salt-change-me
# 32-byte hex string (64 hex chars). The default is the docstring example
# from Langfuse and is safe ONLY for local dev.
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_INIT_ORG_ID=ai-kbs
LANGFUSE_INIT_ORG_NAME=AI-KBS
LANGFUSE_INIT_PROJECT_NAME=ai-kbs
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=aikbs-pk-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=aikbs-sk-dev-change-me
LANGFUSE_INIT_USER_EMAIL=dev@ai-kbs.local
LANGFUSE_INIT_USER_NAME=AI-KBS Dev
LANGFUSE_INIT_USER_PASSWORD=changeme-dev-only