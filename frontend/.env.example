# AI-KBS Frontend Configuration
# Copy this file to .env.local and fill in your values.
# All variables prefixed with VITE_ are exposed to the client bundle.

# Backend API base path (proxied via vite dev server)
VITE_AIKBS_API_BASE=/api/ai-kbs

# Backend server URL (used by vite dev proxy)
VITE_AIKBS_BACKEND_URL=http://localhost:8080

# MCP server URL (used by vite dev proxy)
VITE_AIKBS_MCP_URL=http://localhost:8081

# App title (shown in browser title bar)
VITE_AIKBS_APP_TITLE=AI-KBS

# Default language: zh-CN | en-US
VITE_AIKBS_DEFAULT_LOCALE=zh-CN

# Optional: override frontend commit hash injected by vite.config.ts
# VITE_FRONTEND_COMMIT=